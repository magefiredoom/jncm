# Site settings for the cluster. Copy to site.env (git-ignored), fill in the real values, then run
# `source site.env` in every cluster shell before scripts/launch_phase.sh or scripts/slurm/chain.sh.
# Never commit the real values; scripts/hooks/pre-commit rejects them (install: see RUNBOOK.md).
export FIR_USER=<your-username>          # cluster username; also the User of the `fir` SSH alias
export SBATCH_ACCOUNT=<your-allocation>  # Slurm account; never guessed (SPEC 7)
# export SBATCH_PARTITION=<partition>    # optional; FIR places H100 jobs itself
export GPT2_LARGE_PATH="$HOME/jncm/models/gpt2-large"   # scorer weights; eval and GEN_PPL=1 jobs need it
